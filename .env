# ============================================================
# FinPilot configuration – copy to .env and fill in.
# NEVER commit .env (it is in .gitignore).
# ============================================================
PROJECT_NAME=FinPilot
TIMEZONE=Asia/Kolkata
MARKET_REFRESH_SECONDS=10
DASHBOARD_URL=http://localhost:8501

# ---- Portfolio & storage ----
HOLDINGS_FILE=data/holdings.xlsx
DB_PATH=data/portfolio.db

# ---- Yahoo Finance (the ONLY market-data source) ----
HISTORY_PERIOD=1y
HISTORY_CACHE_MINUTES=360
FUNDAMENTALS_CACHE_HOURS=24
NEWS_CACHE_MINUTES=30
STALE_AFTER_SECONDS=180
BENCHMARK_SYMBOL=^NSEI
# Force a Yahoo symbol when auto-resolution is wrong: PORTFOLIO=YAHOO, comma separated
SYMBOL_OVERRIDES=

# ---- Market session (IST) ----
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:30
PRE_OPEN_TIME=09:00
# Official NSE holidays, YYYY-MM-DD comma separated (FinPilot does not guess holidays)
MARKET_HOLIDAYS=

# ---- Telegram (notifications / reports / alerts ONLY – never trading) ----
# Your group invite link (https://t.me/+...) is NOT a token. Setup:
#   1. In Telegram, message @BotFather -> /newbot -> copy the bot token below.
#   2. Open your FinPilot group via the invite link and add the bot as a member.
#   3. Send any message in the group.
#   4. Run:  python agent.py --telegram-chat-id   and copy the group's chat_id (starts with -100...).
TELEGRAM_BOT_TOKEN=8607150014:AAETgJS-L7c3cK_ktPuoljjse-aT53Q8sw4
TELEGRAM_CHAT_ID=8897604056
TELEGRAM_ENABLED=true
TELEGRAM_SEND_STARTUP=true
TELEGRAM_OPEN_REPORT_TIME=09:20
TELEGRAM_OPEN_REPORT_UNTIL=11:00
TELEGRAM_CLOSE_REPORT_TIME=15:40
TELEGRAM_CLOSE_REPORT_UNTIL=20:00
TELEGRAM_MAX_ALERTS_PER_CYCLE=5
# Up to four holdings for the short performance report (you choose – never assumed)
REPORT_STOCKS=
SCHEDULED_PDF_AT_CLOSE=false

# ---- Alert thresholds ----
ALERT_DAY_MOVE_PCT=5
ALERT_PNL_MOVE_PCT=10
ALERT_VOLUME_RATIO=2.5
ALERT_PORTFOLIO_MOVE_PCT=2
ALERT_IMPORTANT_NEWS=true

# ---- Optional: LLM phrasing for questions the built-in agent rules don't cover ----
# Only FinPilot's calculated data is sent. Leave blank to keep the agent fully local.
ANTHROPIC_API_KEY=
LLM_MODEL=
